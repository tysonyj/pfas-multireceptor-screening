integrator      = md
dt              = 0.002
nsteps          = 50000000       ; 100 ns
nstxout-compressed = 5000        ; every 10 ps
nstenergy       = 5000
nstlog          = 5000
continuation    = yes
constraint_algorithm = lincs
constraints     = h-bonds
cutoff-scheme   = Verlet
nstlist         = 20
rcoulomb        = 1.2
rvdw            = 1.2
coulombtype     = PME
tcoupl          = V-rescale
tc-grps         = Protein_LIG Water_and_ions
tau_t           = 0.1   0.1
ref_t           = 310   310
pcoupl          = C-rescale
pcoupltype      = isotropic
tau_p           = 2.0
ref_p           = 1.0
compressibility = 4.5e-5
pbc             = xyz
DispCorr        = EnerPres
gen_vel         = no
